# 복사: cp .env.example .env  (Git에 .env 올리지 않음)
# 배포: bash deploy.sh  — MySQL·Flyway·BE·FE 자동 (스키마 V*.sql 변경 시 DB 볼륨 자동 초기화)
#
# DB 연결 변수는 MYSQL_* + SPRING_DATASOURCE_* 두 블록만 사용합니다.
# SPRING_DATASOURCE_USERNAME/PASSWORD 는 MYSQL_USER/PASSWORD 와 동일 값이어야 합니다.
# (과거 로컬 bootRun용 DB_URL/DB_USERNAME/DB_PASSWORD 는 사용하지 않음)

# --- MySQL (Docker Compose) ---
# MYSQL_USER/PASSWORD 변경 시 기존 볼륨과 불일치할 수 있음 → docker compose down -v && bash deploy.sh
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=energy_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change_me_mysql_password

# --- Spring Boot (Docker BE — SPRING_DATASOURCE_* = MYSQL_* 와 동일) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/energy_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_mysql_user
SPRING_DATASOURCE_PASSWORD=change_me_mysql_password
SERVER_PORT=8080

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# BE OAuth → FE 리다이렉트 (Docker FE: :8081)
FRONTEND_URL=http://localhost:8081

# FE (Docker build ARG). 비우면 same-origin
VITE_API_HOST=http://localhost:8080
VITE_USE_MOCK=true

# 로컬 FE 개발(yarn dev)은 .env.local 로 Docker BE 연동 — cp .env.local.example .env.local

# JWT (HS256, 32자 이상)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# 신규 회원 기본 소속 (BE app.affiliation.default-name)
DEFAULT_AFFILIATION_NAME=삼육대학교

DEPLOY_PUBLIC_HOST=localhost
# ↑ 배포 완료 메시지에 표시할 접속 주소 (FE/BE URL). 헬스체크에는 사용하지 않음.
