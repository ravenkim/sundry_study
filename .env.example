# 복사: cp .env.example .env  (Git에 .env 올리지 않음)
# Docker: bash deploy.sh  |  로컬 BE: bash be/run-dev.sh  |  로컬 FE: cd fe && yarn dev

# --- MySQL (Docker Compose) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=energy_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change_me_mysql_password

# --- Spring Boot Docker 프로필 (compose be) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/energy_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_mysql_user
SPRING_DATASOURCE_PASSWORD=change_me_mysql_password
SERVER_PORT=8080

# --- Spring Boot 로컬 (./gradlew bootRun) — Docker와 DB가 같으면 MYSQL_* 와 동일 값 ---
DB_URL=jdbc:mysql://localhost:3306/energy_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_mysql_user
DB_PASSWORD=change_me_mysql_password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# BE OAuth → FE 리다이렉트 (Docker FE: :8081, yarn dev: :6075)
FRONTEND_URL=http://localhost:8081

# FE (Docker build ARG·yarn dev). 비우면 same-origin
VITE_API_HOST=http://localhost:8080
VITE_USE_MOCK=true

# JWT (HS256, 32자 이상)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

DEPLOY_PUBLIC_HOST=localhost
