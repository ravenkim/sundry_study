# 로컬 개발용 — 복사: cp .env.example .env
# Spring Boot는 OS 환경변수를 읽습니다. ./gradlew bootRun 전에 export 하거나
# IDE Run Configuration에 아래 값을 등록하세요.
# (현재 application.yaml에 DB 정보가 하드코딩되어 있어, 연동 전까지는 yaml 값이 우선입니다.)

# Database
DB_URL=jdbc:mysql://localhost:3306/DBname?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# Spring Boot 표준 키 (docker 프로필 / Cloud Run — be/.env.docker.example 참고)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/DBname?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# SPRING_DATASOURCE_USERNAME=your_mysql_user
# SPRING_DATASOURCE_PASSWORD=your_mysql_password
# SERVER_PORT=8080

# Kafka (예정)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OAuth2 - Google (예정)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 - Kakao (예정)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
