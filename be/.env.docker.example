# Docker / Cloud Run 실행용 — 복사: cp .env.docker.example .env.docker
# docker compose / be/deploy.sh run / Cloud Run 배포 시 사용

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/DBname?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_mysql_user
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SERVER_PORT=8080
