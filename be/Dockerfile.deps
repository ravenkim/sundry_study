# syntax=docker/dockerfile:1
# build.gradle / settings.gradle 변경 시에만 빌드 (be/deploy.sh)
FROM eclipse-temurin:17-jdk-alpine

WORKDIR /app

COPY gradlew gradlew.bat settings.gradle build.gradle ./
COPY gradle ./gradle

# Gradle 배포판·Maven 캐시를 이미지 레이어에 포함 (cache mount 사용 시 bootJar 단계에서 재다운로드됨)
RUN chmod +x gradlew && \
    ./gradlew --version --no-daemon -q && \
    mkdir -p src/main/java/org/example/be && \
    printf 'package org.example.be;\npublic class DepsPlaceholder {}\n' \
      > src/main/java/org/example/be/DepsPlaceholder.java && \
    ./gradlew dependencies compileJava --no-daemon -q && \
    rm -rf src build
